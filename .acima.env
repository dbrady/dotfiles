[[ -n "$__ACIMA_ENV_LOADED" ]] && return
__ACIMA_ENV_LOADED=1

. ~/.bash_functions

add_to_path "~/acima/bin"

export ROLLBARD_ENV=preflight

# What am I (OS)
export IS_LINUX=false
export IS_WINDOWS=false
export IS_OSX=true
export OS_NAME=$(uname -s)

# Who and where am I
export IS_ACIMA=true
export IS_HOME=false

# Disable this annoying Apple-wants-you-to-upgrade-to-zsh warning:
#
# The default interactive shell is now zsh.
# To update your account to use zsh, please run `chsh -s /bin/zsh`.
# For more details, please visit https://support.apple.com/kb/HT208050.
export BASH_SILENCE_DEPRECATION_WARNING=1
